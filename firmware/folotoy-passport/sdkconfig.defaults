# --- Target Chip ---
CONFIG_IDF_TARGET="esp32c3"
# ESP32-C3 has 400KB internal SRAM and no external PSRAM.

# --- 8 MB Flash & Merged Binary Friendly ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Console: Native USB-Serial-JTAG (GPIO18/19) ---
# UART0 TX (GPIO21) conflicts with LCD backlight PWM on FoloToy AI Passport.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Disable BLE to save ~50KB internal SRAM & ensure Web Simulator compatibility ---
CONFIG_BT_ENABLED=n

# --- LVGL 9.5 (16-bit RGB565 + System Heap + CJK + Montserrat Fallback) ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y

# --- FreeRTOS & Networking ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_LWIP_MAX_SOCKETS=8
